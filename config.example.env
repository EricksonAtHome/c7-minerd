# CentralDataBase/C7 JSON-RPC endpoint
# When running standalone or on host: http://127.0.0.1:13431/
# When running inside docker-compose network: http://c7-node:13431/
RPC_URL=http://c7-node:13431/
RPC_USER=c7miner
RPC_PASSWORD=change-me

# Optional cookie authentication. If set, RPC_USER/RPC_PASSWORD are ignored.
# RPC_COOKIE=/home/centraldatabase/.centraldatabasecore/.cookie

# Explorer endpoint for block verification and live check
EXPLORER_URL=https://blocks.prysel.com/

# Address receiving the block reward (Valid C7 Base58 address).
MINER_ADDRESS=CGZCSzBowAqgHcXPtMT3vs7ycp8hLi5UAD

# Maximum nonce/hash attempts per RPC call.
MAX_TRIES=1000000

# Number of blocks to attempt generating per call.
BLOCKS_PER_CALL=1

# Delay in seconds after a completed call.
SLEEP_SECONDS=1

# Optional log prefix.
MINER_NAME=c7-minerd
